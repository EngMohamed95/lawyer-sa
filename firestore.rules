rules_version = '2';

/**
 * قواعد حماية Firestore — الميزة 001، الثغرة V1.
 *
 * ما كان قائماً:  allow read, write: if request.auth != null;
 * أثره: أي مستخدم مسجَّل في المشروع يقرأ ويعدّل ويحذف بيانات **كل المكاتب**.
 *
 * المبدأ: العزل بحقل lawyerId القائم — بلا هجرة بيانات وبلا حقل جديد.
 * (فُحص فعلياً: 100% من سجلات clients/cases/tasks/payments/expenses/contracts/
 *  invoices/appointments/auditLogs/notifications تحمل lawyerId)
 *
 * ⚠️ ملاحظة تشغيلية حاسمة:
 *    مستند مالك المكتب في users/ لا يحمل lawyerId — الاتفاق القائم أن
 *    lawyerId = uid. لذلك myTenant() ترجع uid عند غياب الحقل. بدون هذا
 *    يُقفل المالك خارج نظامه بالكامل.
 *
 * ⚠️ النشر على مرحلتين (AD-5): انشرها على مشروع اختبار أولاً، أو راقب
 *    رفض الطلبات في Firebase Console > Firestore > Usage قبل الاعتماد.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ────────────────────────── دوال مساعدة ────────────────────────── */

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function myRole() {
      return userExists() ? userData().get('role', 'TRAINEE') : 'NONE';
    }

    // مالك المكتب لا يحمل lawyerId في مستنده — الاتفاق أن lawyerId = uid
    function myTenant() {
      return userExists()
        ? userData().get('lawyerId', request.auth.uid)
        : request.auth.uid;
    }

    function blockedStatus(st) {
      return st in ['SUSPENDED', 'DISABLED'];
    }

    /**
     * الحساب نشط: غير موقوف ولا معطَّل ولا محذوف من الفريق، ومكتبه نفسه غير معطَّل.
     * (التطبيق يعطّل بـ DISABLED — كانت القاعدة تفحص SUSPENDED وحدها فيبقى المعطَّل يصل للبيانات)
     */
    function notSuspended() {
      return userExists()
        && !blockedStatus(userData().get('status', 'ACTIVE'))
        && userData().get('deletedAt', null) == null
        && officeActive();
    }

    /** عضو الفريق يتبع حالة مالك مكتبه — تعطيل المكتب يقطع وصول فريقه كله */
    function officeActive() {
      let tenant = userData().get('lawyerId', request.auth.uid);
      return userData().get('role', '') == 'SUPER_ADMIN' || tenant == request.auth.uid || tenant == 'ALL'
        || !blockedStatus(get(/databases/$(database)/documents/users/$(tenant)).data.get('status', 'ACTIVE'));
    }

    /** عميل البوابة ليس من فريق المكتب — لا يصل لبيانات المكتب الداخلية */
    function staff() {
      return myRole() != 'CLIENT';
    }

    function isSuperAdmin() {
      return signedIn() && myRole() == 'SUPER_ADMIN';
    }

    function isOfficeOwner() {
      return signedIn() && myRole() == 'LAWYER';
    }

    function member() {
      return signedIn() && notSuspended() && staff();
    }

    /**
     * حقول الاشتراك يكتبها مدير المنصة (أو signup.php بحساب الخدمة) وحده —
     * لا يستطيع مالك المكتب تمديد اشتراكه أو ترقية باقته أو تغيير حصصه بنفسه.
     */
    function subscriptionFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'plan', 'planId', 'status', 'subscriptionExpiry', 'subscriptionStart',
        'subscriptionBilling', 'quotaOverrides', 'selfSignup', 'emailVerifiedAt', 'trialEndsAt'
      ]);
    }

    /** السجل الموجود يخص مكتبي */
    function ownsExisting() {
      return resource != null && resource.data.get('lawyerId', '') == myTenant();
    }

    /** السجل القادم يخص مكتبي — يمنع كتابة بيانات باسم مكتب آخر */
    function ownsIncoming() {
      return request.resource.data.get('lawyerId', '') == myTenant();
    }

    function canRead() {
      return member() && (isSuperAdmin() || ownsExisting());
    }

    /**
     * الفترة التجريبية للتسجيل الذاتي انتهت بلا اشتراك؟ — الكتابة مقفلة على المكتب كله
     * (القراءة تبقى: البيانات محفوظة). signup.php يكتب trialEndsAt كـ Timestamp، وتفعيل
     * أي اشتراك مدفوع يغيّر subscriptionBilling فيُفتح القفل. مستند المالك = myTenant().
     */
    function officeWritable() {
      let owner = get(/databases/$(database)/documents/users/$(myTenant())).data;
      return owner.get('subscriptionBilling', '') != 'trial'
        || !('trialEndsAt' in owner)
        || owner.trialEndsAt > request.time;
    }

    function canCreate() {
      return member() && (isSuperAdmin() || (ownsIncoming() && officeWritable()));
    }

    /** التعديل يفحص القادم والموجود معاً، ويمنع نقل السجل لمكتب آخر */
    function canUpdate() {
      return member() && (
        isSuperAdmin() ||
        (
          officeWritable() &&
          ownsExisting() &&
          ownsIncoming() &&
          request.resource.data.get('lawyerId', '') == resource.data.get('lawyerId', '')
        )
      );
    }

    function canDelete() {
      return member() && (isSuperAdmin() || (ownsExisting() && officeWritable()));
    }

    /** الحذف النهائي داخل المكتب — لمدير المكتب وحده */
    function canHardDelete() {
      return member() && (isSuperAdmin() || (ownsExisting() && isOfficeOwner() && officeWritable()));
    }

    /* ────────────────────────── المستخدمون ────────────────────────── */

    match /users/{userId} {
      // كل مستخدم يقرأ مستنده دائماً — بدونه تفشل كل الدوال أعلاه
      allow get: if signedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        resource.data.get('lawyerId', userId) == myTenant()
      );

      // القائمة لفريق المكتب نفسه فقط — الاستعلام يجب أن يحدّد lawyerId == مكتبي.
      // (كانت isOfficeOwner() وحدها، فكان أي مالك مكتب يستطيع سرد مستخدمي كل المكاتب)
      allow list: if isSuperAdmin() || (member() && resource.data.get('lawyerId', '') == myTenant());

      allow create: if member() && (
        isSuperAdmin() ||
        (isOfficeOwner() && request.resource.data.get('lawyerId', '') == myTenant()
          && request.resource.data.get('role', '') in ['PARTNER', 'OFFICE_LAWYER', 'CONSULTANT', 'SECRETARY', 'ACCOUNTANT', 'TRAINEE', 'CLIENT'])
      );

      /**
       * الترقية الذاتية ممنوعة (الثغرتان V5 و V7).
       * المستخدم العادي يعدّل بياناته الشخصية فقط؛ الحقول الحسّاسة
       * (role · lawyerId · plan · status) تبقى كما هي حرفياً.
       */
      allow update: if member() && (
        isSuperAdmin()
        ||
        (
          isOfficeOwner() &&
          resource.data.get('lawyerId', userId) == myTenant() &&
          request.resource.data.get('lawyerId', userId) == resource.data.get('lawyerId', userId) &&
          (userId != request.auth.uid || subscriptionFieldsUnchanged()) &&
          (request.resource.data.get('role', '') == resource.data.get('role', '') ||
            (userId != request.auth.uid && resource.data.get('role', '') != 'SUPER_ADMIN' &&
              request.resource.data.get('role', '') in ['PARTNER', 'OFFICE_LAWYER', 'CONSULTANT', 'SECRETARY', 'ACCOUNTANT', 'TRAINEE', 'CLIENT']))
        )
        ||
        (
          request.auth.uid == userId &&
          request.resource.data.get('role', '')     == resource.data.get('role', '') &&
          request.resource.data.get('lawyerId', '') == resource.data.get('lawyerId', '') &&
          request.resource.data.get('plan', '')     == resource.data.get('plan', '') &&
          request.resource.data.get('status', '')   == resource.data.get('status', '') &&
          request.resource.data.get('deletedAt', null) == resource.data.get('deletedAt', null) &&
          subscriptionFieldsUnchanged()
        )
      );

      allow delete: if isSuperAdmin() || (
        member() && isOfficeOwner() && userId != request.auth.uid &&
        resource.data.get('lawyerId', '') == myTenant() &&
        resource.data.get('role', '') in ['PARTNER', 'OFFICE_LAWYER', 'CONSULTANT', 'SECRETARY', 'ACCOUNTANT', 'TRAINEE', 'CLIENT']
      );
    }

    /* ────────────────────────── طلبات الاشتراك ────────────────────────── */

    // تُنشأ قبل وجود حساب — الإنشاء مفتوح، وما عداه للسوبر أدمن
    match /subscriptionRequests/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    /* ────────────────────────── رموز تأكيد التسجيل ────────────────────────── */

    // رموز OTP للتسجيل الذاتي — يكتبها ويقرؤها signup.php بحساب الخدمة وحده.
    // لا وصول للعميل إطلاقاً، ولا حتى لمدير المنصة (الرمز مُجزَّأ أصلاً).
    match /signup_otps/{uid} {
      allow read, write: if false;
    }

    /* ────────────────────────── القضايا والعملاء ────────────────────────── */

    /**
     * المحامي (OFFICE_LAWYER) يصل للقضايا المكلَّف بها فقط؛ باقي الأدوار بلا قيد إضافي.
     * القضية قد يتولاها أكثر من محامٍ (assignedLawyerIds)، والقضايا القديمة تحمل assignedLawyerId فقط.
     */
    function caseAssignedToMe(caseData) {
      return myRole() != 'OFFICE_LAWYER'
        || caseData.get('assignedLawyerId', '') == request.auth.uid
        || request.auth.uid in caseData.get('assignedLawyerIds', []);
    }

    match /cases/{caseId} {
      allow get, list: if canRead() && caseAssignedToMe(resource.data);
      allow create: if canCreate();
      allow update: if canUpdate() && caseAssignedToMe(resource.data);
      allow delete: if canHardDelete();

      // الجلسات والمستندات والمذكرات والطلبات ترث حدود القضية الأم — ومنها التكليف
      match /{document=**} {
        function parentCaseOk() {
          let c = get(/databases/$(database)/documents/cases/$(caseId)).data;
          return c.get('lawyerId', '') == myTenant() && caseAssignedToMe(c);
        }
        // المستند الجديد لا يحمل lawyerId مكتب آخر — وإلا ظهر في مستندات ذلك المكتب ومساعده
        function incomingSameOffice() {
          return request.resource.data.get('lawyerId', myTenant()) == myTenant();
        }
        allow read: if member() && (isSuperAdmin() || parentCaseOk());
        allow create, update: if member() && (isSuperAdmin() || (parentCaseOk() && incomingSameOffice() && officeWritable()));
        allow delete: if member() && (isSuperAdmin() || (parentCaseOk() && officeWritable()));
      }
    }

    /**
     * استعلامات collectionGroup تحتاج قاعدة تبدأ بـ {path=**} — القواعد المتداخلة أعلاه لا تكفيها.
     * الجلسات عبر كل القضايا: لمدير المنصة وحده (لوحة المنصة وصفحة الجلسات).
     * المستندات عبر كل القضايا والعملاء: لكل مكتب مستنداته (lawyerId) — صفحة المستندات والمساعد.
     */
    match /{path=**}/hearings/{hearingId} {
      allow read: if isSuperAdmin();
    }

    // المحامي المكلَّف (OFFICE_LAWYER) مستثنى: هذه القاعدة تنطبق أيضاً على cases/{id}/documents
    // فكانت تتخطى شرط التكليف. يقرأ مستندات قضاياه من القاعدة المتداخلة (assignedDocuments).
    match /{path=**}/documents/{documentId} {
      allow read: if member() && (isSuperAdmin() ||
        (myRole() != 'OFFICE_LAWYER' && resource.data.get('lawyerId', '') == myTenant()));
    }

    match /clients/{clientId} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canHardDelete();

      match /{document=**} {
        function parentClientOk() {
          return get(/databases/$(database)/documents/clients/$(clientId)).data.get('lawyerId', '') == myTenant();
        }
        allow read: if member() && (isSuperAdmin() || parentClientOk());
        allow create, update: if member() && (isSuperAdmin() || (parentClientOk()
          && request.resource.data.get('lawyerId', myTenant()) == myTenant() && officeWritable()));
        allow delete: if member() && (isSuperAdmin() || (parentClientOk() && officeWritable()));
      }
    }

    /* ────────────────────────── المجموعات المعزولة بـ lawyerId ──────────────────────────
     * قواعد Firestore لا تدعم شرطاً على اسم المجموعة، فتُذكر كل مجموعة صراحةً.
     * إضافة مجموعة جديدة للتطبيق تتطلب إضافتها هنا — وهذا مقصود لا سهو.
     */

    match /tasks/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /payments/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /expenses/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /contracts/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /invoices/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /receipts/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /vouchers/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /fee_agreements/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /time_entries/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /appointments/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    // الإشعارات وتفضيلاتها تُقرأ بـ where userId == المستخدم — نسمح لصاحبها بقراءتها
    match /notifications/{id} {
      allow get, list: if canRead() || (member() && resource.data.get('userId', '') == request.auth.uid
        && resource.data.get('lawyerId', myTenant()) == myTenant());
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /notification_preferences/{id} {
      allow get, list: if canRead() || (member() && resource.data.get('userId', '') == request.auth.uid
        && resource.data.get('lawyerId', myTenant()) == myTenant());
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    /* ────────────────────── المكتبة القانونية الشخصية ────────────────────── */

    /**
     * محفظة خاصة بكل مستخدم: الأنظمة والقرارات والتعاميم والأوامر السامية.
     * لا يقرأها ولا يعدّلها إلا صاحبها (ownerId) — ولا مدير المكتب. مدير المنصة يطّلع ويحذف فقط.
     */
    function validLibraryFile(f, owner) {
      return f == null || (
        f.keys().hasOnly(['path', 'name', 'size', 'contentType'])
        && f.path is string && f.path.matches('legalLibrary/' + owner + '/[A-Za-z0-9-]+')
        && f.name is string && f.name.size() > 0 && f.name.size() <= 200
        && f.size is int && f.size > 0 && f.size <= 52428800
        && f.contentType in ['application/pdf', 'application/msword',
                             'application/vnd.openxmlformats-officedocument.wordprocessingml.document']
      );
    }

    function validLibraryItem(d) {
      return d.keys().hasOnly(['type', 'title', 'number', 'issueDate', 'issuer', 'summary',
                               'content', 'sourceUrl', 'file', 'ownerId', 'createdAt', 'updatedAt'])
        && validLibraryFile(d.get('file', null), d.ownerId)
        && d.type in ['REGULATION', 'DECISION', 'CIRCULAR', 'ROYAL_ORDER']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 300
        && d.get('number', '') is string && d.get('number', '').size() <= 100
        && d.get('issueDate', '') is string && d.get('issueDate', '').size() <= 50
        && d.get('issuer', '') is string && d.get('issuer', '').size() <= 200
        && d.get('summary', '') is string && d.get('summary', '').size() <= 2000
        && d.get('content', '') is string && d.get('content', '').size() <= 300000
        && d.get('sourceUrl', '') is string && d.get('sourceUrl', '').size() <= 1000;
    }

    match /legal_library/{id} {
      allow get, list: if isSuperAdmin() || (member() && resource.data.ownerId == request.auth.uid);
      allow create: if member()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validLibraryItem(request.resource.data);
      allow update: if member()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validLibraryItem(request.resource.data);
      allow delete: if isSuperAdmin() || (member() && resource.data.ownerId == request.auth.uid);
    }

    match /office_settings/{id} {
      allow get: if member() && (isSuperAdmin() || id == myTenant() || ownsExisting());
      allow list: if canRead();
      // إعدادات المكتب: التعديل لمدير المكتب وحده
      allow create, update: if member() && (
        isSuperAdmin() || (isOfficeOwner() && ownsIncoming())
      );
      allow delete: if isSuperAdmin();
    }

    match /counters/{id} {
      // عدّادات الترقيم التسلسلي — تُقرأ وتُكتب داخل معاملة من التطبيق.
      // المعرّف {lawyerId}_{scope}_{year}: نسمح بقراءته قبل وجوده (أول فاتورة في السنة)
      // بمطابقة بادئة المعرّف، لأن resource يكون null فلا يصلح ownsExisting().
      allow get: if member() && (isSuperAdmin() || id.matches('^' + myTenant() + '_.+'));
      allow create, update: if canCreate();
      allow list, delete: if isSuperAdmin();
    }

    match /client_portal_accounts/{id} {
      allow get, list: if canRead();
      // حسابات البوابة: إنشاؤها وتعديلها لمدير المكتب وحده
      allow create, update: if member() && (
        isSuperAdmin() || (isOfficeOwner() && ownsIncoming())
      );
      allow delete: if canHardDelete();
    }

    match /client_messages/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /client_requests/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /template_folders/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /custom_templates/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    // المذكرات العامة من صفحة «كتابة مذكرة» — غير مرتبطة بقضية
    match /general_memos/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    /* ────────────────────────── السجلات غير القابلة للتعديل ────────────────────────── */

    // سجل التدقيق لا يُعدَّل ولا يُحذف — وإلا فقد قيمته كدليل (الوثيقة §خامساً)
    match /auditLogs/{id} {
      allow get, list: if canRead();
      allow create: if member() && (isSuperAdmin() || ownsIncoming());
      allow update, delete: if false;
    }

    // سجل الوصول للمستندات السرية — نفس المنطق
    match /documents_access_log/{id} {
      allow get, list: if canRead();
      allow create: if member() && (isSuperAdmin() || ownsIncoming());
      allow update, delete: if false;
    }

    // المقترحات يراها مقدمها ومدير المنصة فقط. المستخدم ينشئ، والإدارة تراجع وترد.
    match /productSuggestions/{suggestionId} {
      function suggestionParticipant() {
        return member() && (isSuperAdmin() || resource.data.createdBy == request.auth.uid);
      }
      allow read: if suggestionParticipant();
      allow create: if member() && !isSuperAdmin()
        && request.resource.data.keys().hasOnly(['title', 'details', 'category', 'status', 'createdBy', 'requesterName', 'lawyerId', 'adminResponse', 'createdAt', 'updatedAt', 'respondedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lawyerId == myTenant()
        && request.resource.data.requesterName is string && request.resource.data.requesterName.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 200
        && request.resource.data.details is string && request.resource.data.details.size() >= 10 && request.resource.data.details.size() <= 4000
        && request.resource.data.category in ['واجهة وتجربة المستخدم', 'إدارة القضايا والجلسات', 'الحسابات والتقارير', 'المستندات والعقود', 'الذكاء الاصطناعي', 'ميزة جديدة أخرى']
        && request.resource.data.status == 'RECEIVED'
        && request.resource.data.adminResponse == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.respondedAt == null;
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminResponse', 'updatedAt', 'respondedAt'])
        && request.resource.data.status in ['RECEIVED', 'UNDER_REVIEW', 'PLANNED', 'IMPLEMENTED', 'DECLINED']
        && request.resource.data.adminResponse is string && request.resource.data.adminResponse.size() <= 4000
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.adminResponse == '' && request.resource.data.respondedAt == null)
          || (request.resource.data.adminResponse.size() > 0 && request.resource.data.respondedAt == request.time));
      allow delete: if false;
    }

    // الدعم بين مقدم الطلب وإدارة المنصة فقط، وليس بقية أعضاء المكتب.
    match /supportTickets/{ticketId} {
      function attachment(a) {
        return a.keys().hasOnly(['name', 'path', 'size', 'type'])
          && a.name is string && a.name.size() > 0 && a.name.size() <= 200
          && a.path is string && a.path.matches('supportAttachments/' + ticketId + '/' + request.auth.uid + '/[^/]+')
          && a.size is int && a.size > 0 && a.size <= 5242880
          && a.type in ['image/png', 'image/jpeg', 'image/webp', 'application/pdf'];
      }
      function attachments(data) {
        let a = data.attachments;
        return a is list && a.size() <= 4
          && (a.size() < 1 || attachment(a[0])) && (a.size() < 2 || attachment(a[1]))
          && (a.size() < 3 || attachment(a[2])) && (a.size() < 4 || attachment(a[3]));
      }
      function participant() {
        return member() && (isSuperAdmin() || resource.data.createdBy == request.auth.uid);
      }
      function validStatus() {
        return request.resource.data.status in ['OPEN', 'IN_PROGRESS', 'WAITING', 'RESOLVED', 'CLOSED'];
      }
      function newReply() {
        let messageId = request.resource.data.lastMessageId;
        let path = /databases/$(database)/documents/supportTickets/$(ticketId)/messages/$(messageId);
        return messageId is string && messageId.size() > 0
          && messageId != resource.data.lastMessageId
          && !exists(path)
          && getAfter(path).data.senderId == request.auth.uid
          && getAfter(path).data.createdAt == request.time
          && request.resource.data.messageCount == resource.data.messageCount + 1
          && !(resource.data.status in ['CLOSED', 'RESOLVED'])
          && request.resource.data.status == (isSuperAdmin() ? 'WAITING' : 'OPEN')
          && request.resource.data.lastReplyBy == (isSuperAdmin() ? 'ADMIN' : 'USER');
      }
      allow read: if participant();
      allow create: if member() && !isSuperAdmin()
        && request.resource.data.keys().hasOnly(['subject', 'description', 'category', 'priority', 'status', 'createdBy', 'requesterName', 'lawyerId', 'createdAt', 'updatedAt', 'lastMessageId', 'lastReplyBy', 'messageCount', 'attachments'])
        && attachments(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lawyerId == myTenant()
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3 && request.resource.data.subject.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 3000
        && request.resource.data.category in ['مشكلة تقنية أو عطل في النظام', 'الحساب والصلاحيات', 'الاشتراكات والفواتير والمدفوعات', 'اقتراح وتطوير', 'استفسار عام أو مساعدة']
        && request.resource.data.priority in ['LOW', 'NORMAL', 'HIGH', 'URGENT']
        && request.resource.data.status == 'OPEN'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageId == '' && request.resource.data.lastReplyBy == ''
        && request.resource.data.messageCount == 1;
      allow update: if participant() && validStatus()
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && (isSuperAdmin() || (resource.data.status in ['RESOLVED', 'CLOSED'] && request.resource.data.status == 'OPEN') || request.resource.data.status == 'CLOSED'))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'lastMessageId', 'lastReplyBy', 'messageCount']) && newReply())
        );
      allow delete: if false;

      match /messages/{messageId} {
        function ticket() {
          return get(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
        }
        function ticketAfter() {
          return getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
        }
        allow read: if member() && (isSuperAdmin() || ticket().createdBy == request.auth.uid);
        allow create: if member() && (isSuperAdmin() || ticket().createdBy == request.auth.uid)
          && !(ticket().status in ['CLOSED', 'RESOLVED'])
          && request.resource.data.keys().hasOnly(['body', 'senderId', 'senderName', 'isAdmin', 'createdAt', 'attachments'])
          && attachments(request.resource.data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 200
          && request.resource.data.isAdmin == isSuperAdmin()
          && request.resource.data.body is string && request.resource.data.body.size() <= 10000
          && (request.resource.data.body.size() > 0 || request.resource.data.attachments.size() > 0)
          && request.resource.data.createdAt == request.time
          && ticketAfter().lastMessageId == messageId && ticketAfter().updatedAt == request.time
          && ticketAfter().messageCount == ticket().messageCount + 1;
        allow update, delete: if false;
      }
    }

    /* ────────────────────────── إعدادات المنصة ────────────────────────── */

    // يقرؤها كل مستخدم مسجّل (مزايا الذكاء الاصطناعي)، ويعدّلها مدير المنصة وحده
    match /platform_settings/{id} {
      allow read: if signedIn();
      allow write: if isSuperAdmin();
    }

    /* ────────────────────────── باقات الاشتراك ────────────────────────── */

    // أسعار وحدود عامة تُعرض لكل زائر (صفحة الاشتراك)، والتعديل لمدير المنصة وحده
    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    /* ────────────────────────── محادثات المساعد الذكي ────────────────────────── */

    // كل محادثة ملك صاحبها (userId = uid) — لا يراها زملاؤه في المكتب. مدير المنصة يطّلع ويحذف فقط.
    // المساعد واحد على مستوى المنصة، لكن ذاكرة كل مستخدم (سجل محادثاته) معزولة عن غيره.
    // lawyerId يُثبَّت على مكتب المستخدم عند الإنشاء (مدير المنصة يحمل "ALL")، ولا يتغيّر المالك بعدها.
    match /ai_conversations/{id} {
      // صاحبها، وفي مكتبه الحالي — عضو انتقل لمكتب آخر لا يرى محادثات مكتبه القديم
      function ownsConversation() {
        return resource.data.get('userId', '') == request.auth.uid
          && (isSuperAdmin() || resource.data.get('lawyerId', myTenant()) == myTenant());
      }

      allow get, list: if isSuperAdmin() || (member() && ownsConversation());
      allow create: if member()
        && request.resource.data.get('userId', '') == request.auth.uid
        && (request.resource.data.get('lawyerId', '') == myTenant() || isSuperAdmin())
        && request.resource.data.messages is list;
      allow update: if member()
        && ownsConversation()
        && request.resource.data.get('userId', '') == resource.data.get('userId', '')
        && request.resource.data.get('lawyerId', '') == resource.data.get('lawyerId', '')
        && request.resource.data.messages is list;
      allow delete: if isSuperAdmin() || (member() && ownsConversation());
    }

    /* ────────────────────────── استهلاك المساعد الذكي ────────────────────────── */

    // عدّاد شهري لكل مكتب: المعرّف {lawyerId}_{YYYY-MM}. يكتبه وسيط الذكاء الاصطناعي
    // بتوكن المستخدم بعد كل رد ناجح. لا يُسمح إلا بزيادة 1 بالضبط — فلا يستطيع أحد
    // إنقاص عدّاد مكتبه أو تصفيره، ولا لمس عدّاد مكتب آخر.
    match /ai_usage/{id} {
      function usageFieldsOk() {
        return request.resource.data.keys().hasOnly(['lawyerId', 'month', 'count', 'updatedAt'])
          && request.resource.data.month is string
          && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
          && id == request.resource.data.lawyerId + '_' + request.resource.data.month
          && request.resource.data.updatedAt == request.time;
      }

      // قراءة عدّاد مكتبي بالمعرّف حتى قبل وجوده (فيظهر 0 بدل خطأ صلاحية)
      allow get: if member() && (isSuperAdmin() || id.matches('^' + myTenant() + '_[0-9]{4}-[0-9]{2}$'));
      allow list: if isSuperAdmin();
      allow create: if member() && !isSuperAdmin() && usageFieldsOk()
        && request.resource.data.lawyerId == myTenant()
        && request.resource.data.count == 1;
      allow update: if member() && !isSuperAdmin() && usageFieldsOk()
        && resource.data.lawyerId == myTenant()
        && request.resource.data.lawyerId == resource.data.lawyerId
        && request.resource.data.month == resource.data.month
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    /* ────────────────────────── حالة خدمة المنصة ────────────────────────── */

    // platform_status/ai: يسجّل وسيط الذكاء الاصطناعي توقف مفتاح المنصة (DOWN) وعودته (OK)
    // بتوكن المستخدم الذي صادف الخلل، ليظهر تنبيه لمدير المنصة. القراءة لمدير المنصة وحده.
    match /platform_status/{id} {
      allow read: if isSuperAdmin();
      allow create, update: if member() && id == 'ai'
        && request.resource.data.keys().hasOnly(['state', 'reason', 'httpStatus', 'at'])
        && request.resource.data.state in ['DOWN', 'OK']
        && request.resource.data.reason in ['', 'QUOTA', 'ACCOUNT', 'MANUAL']
        && request.resource.data.httpStatus is int
        && request.resource.data.at == request.time;
      allow delete: if isSuperAdmin();
    }

    /* ────────────────────────── الافتراضي: الرفض ────────────────────────── */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
