rules_version = '2';

/**
 * قواعد حماية Firestore — الميزة 001، الثغرة V1.
 *
 * ما كان قائماً:  allow read, write: if request.auth != null;
 * أثره: أي مستخدم مسجَّل في المشروع يقرأ ويعدّل ويحذف بيانات **كل المكاتب**.
 *
 * المبدأ: العزل بحقل lawyerId القائم — بلا هجرة بيانات وبلا حقل جديد.
 * (فُحص فعلياً: 100% من سجلات clients/cases/tasks/payments/expenses/contracts/
 *  invoices/appointments/auditLogs/notifications تحمل lawyerId)
 *
 * ⚠️ ملاحظة تشغيلية حاسمة:
 *    مستند مالك المكتب في users/ لا يحمل lawyerId — الاتفاق القائم أن
 *    lawyerId = uid. لذلك myTenant() ترجع uid عند غياب الحقل. بدون هذا
 *    يُقفل المالك خارج نظامه بالكامل.
 *
 * ⚠️ النشر على مرحلتين (AD-5): انشرها على مشروع اختبار أولاً، أو راقب
 *    رفض الطلبات في Firebase Console > Firestore > Usage قبل الاعتماد.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    /* ────────────────────────── دوال مساعدة ────────────────────────── */

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return signedIn() && exists(userPath());
    }

    function userData() {
      return get(userPath()).data;
    }

    function myRole() {
      return userExists() ? userData().get('role', 'TRAINEE') : 'NONE';
    }

    // مالك المكتب لا يحمل lawyerId في مستنده — الاتفاق أن lawyerId = uid
    function myTenant() {
      return userExists()
        ? userData().get('lawyerId', request.auth.uid)
        : request.auth.uid;
    }

    function notSuspended() {
      return userExists() && userData().get('status', 'ACTIVE') != 'SUSPENDED';
    }

    function isSuperAdmin() {
      return signedIn() && myRole() == 'SUPER_ADMIN';
    }

    function isOfficeOwner() {
      return signedIn() && myRole() == 'LAWYER';
    }

    function member() {
      return signedIn() && notSuspended();
    }

    /** السجل الموجود يخص مكتبي */
    function ownsExisting() {
      return resource != null && resource.data.get('lawyerId', '') == myTenant();
    }

    /** السجل القادم يخص مكتبي — يمنع كتابة بيانات باسم مكتب آخر */
    function ownsIncoming() {
      return request.resource.data.get('lawyerId', '') == myTenant();
    }

    function canRead() {
      return member() && (isSuperAdmin() || ownsExisting());
    }

    function canCreate() {
      return member() && (isSuperAdmin() || ownsIncoming());
    }

    /** التعديل يفحص القادم والموجود معاً، ويمنع نقل السجل لمكتب آخر */
    function canUpdate() {
      return member() && (
        isSuperAdmin() ||
        (
          ownsExisting() &&
          ownsIncoming() &&
          request.resource.data.get('lawyerId', '') == resource.data.get('lawyerId', '')
        )
      );
    }

    function canDelete() {
      return member() && (isSuperAdmin() || ownsExisting());
    }

    /** الحذف النهائي داخل المكتب — لمدير المكتب وحده */
    function canHardDelete() {
      return member() && (isSuperAdmin() || (ownsExisting() && isOfficeOwner()));
    }

    /* ────────────────────────── المستخدمون ────────────────────────── */

    match /users/{userId} {
      // كل مستخدم يقرأ مستنده دائماً — بدونه تفشل كل الدوال أعلاه
      allow get: if signedIn() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        resource.data.get('lawyerId', userId) == myTenant()
      );

      allow list: if signedIn() && (isSuperAdmin() || isOfficeOwner());

      allow create: if member() && (
        isSuperAdmin() ||
        (isOfficeOwner() && request.resource.data.get('lawyerId', '') == myTenant()
          && request.resource.data.get('role', '') in ['PARTNER', 'OFFICE_LAWYER', 'CONSULTANT', 'SECRETARY', 'ACCOUNTANT', 'TRAINEE', 'CLIENT'])
      );

      /**
       * الترقية الذاتية ممنوعة (الثغرتان V5 و V7).
       * المستخدم العادي يعدّل بياناته الشخصية فقط؛ الحقول الحسّاسة
       * (role · lawyerId · plan · status) تبقى كما هي حرفياً.
       */
      allow update: if member() && (
        isSuperAdmin()
        ||
        (
          isOfficeOwner() &&
          resource.data.get('lawyerId', userId) == myTenant() &&
          request.resource.data.get('lawyerId', userId) == resource.data.get('lawyerId', userId) &&
          (request.resource.data.get('role', '') == resource.data.get('role', '') ||
            (userId != request.auth.uid && resource.data.get('role', '') != 'SUPER_ADMIN' &&
              request.resource.data.get('role', '') in ['PARTNER', 'OFFICE_LAWYER', 'CONSULTANT', 'SECRETARY', 'ACCOUNTANT', 'TRAINEE', 'CLIENT']))
        )
        ||
        (
          request.auth.uid == userId &&
          request.resource.data.get('role', '')     == resource.data.get('role', '') &&
          request.resource.data.get('lawyerId', '') == resource.data.get('lawyerId', '') &&
          request.resource.data.get('plan', '')     == resource.data.get('plan', '') &&
          request.resource.data.get('status', '')   == resource.data.get('status', '')
        )
      );

      allow delete: if isSuperAdmin();
    }

    /* ────────────────────────── طلبات الاشتراك ────────────────────────── */

    // تُنشأ قبل وجود حساب — الإنشاء مفتوح، وما عداه للسوبر أدمن
    match /subscriptionRequests/{docId} {
      allow create: if true;
      allow read, update, delete: if isSuperAdmin();
    }

    /* ────────────────────────── القضايا والعملاء ────────────────────────── */

    /**
     * المحامي (OFFICE_LAWYER) يصل للقضايا المكلَّف بها فقط؛ باقي الأدوار بلا قيد إضافي.
     * القضية قد يتولاها أكثر من محامٍ (assignedLawyerIds)، والقضايا القديمة تحمل assignedLawyerId فقط.
     */
    function caseAssignedToMe(caseData) {
      return myRole() != 'OFFICE_LAWYER'
        || caseData.get('assignedLawyerId', '') == request.auth.uid
        || request.auth.uid in caseData.get('assignedLawyerIds', []);
    }

    match /cases/{caseId} {
      allow get, list: if canRead() && caseAssignedToMe(resource.data);
      allow create: if canCreate();
      allow update: if canUpdate() && caseAssignedToMe(resource.data);
      allow delete: if canHardDelete();

      // الجلسات والمستندات والمذكرات والطلبات ترث حدود القضية الأم — ومنها التكليف
      match /{document=**} {
        allow read, write: if member() && (
          isSuperAdmin() || (
            get(/databases/$(database)/documents/cases/$(caseId)).data.get('lawyerId', '') == myTenant() &&
            caseAssignedToMe(get(/databases/$(database)/documents/cases/$(caseId)).data)
          )
        );
      }
    }

    match /clients/{clientId} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canHardDelete();

      match /{document=**} {
        allow read, write: if member() && (
          isSuperAdmin() ||
          get(/databases/$(database)/documents/clients/$(clientId)).data.get('lawyerId', '') == myTenant()
        );
      }
    }

    /* ────────────────────────── المجموعات المعزولة بـ lawyerId ──────────────────────────
     * قواعد Firestore لا تدعم شرطاً على اسم المجموعة، فتُذكر كل مجموعة صراحةً.
     * إضافة مجموعة جديدة للتطبيق تتطلب إضافتها هنا — وهذا مقصود لا سهو.
     */

    match /tasks/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /payments/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /expenses/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /contracts/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /invoices/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /receipts/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /vouchers/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /fee_agreements/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /time_entries/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /appointments/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /notifications/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /notification_preferences/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /office_settings/{id} {
      allow get, list: if canRead();
      // إعدادات المكتب: التعديل لمدير المكتب وحده
      allow create, update: if member() && (
        isSuperAdmin() || (isOfficeOwner() && ownsIncoming())
      );
      allow delete: if isSuperAdmin();
    }

    match /counters/{id} {
      // عدّادات الترقيم التسلسلي — تُقرأ وتُكتب داخل معاملة من التطبيق
      allow get: if canRead();
      allow create, update: if canCreate();
      allow list, delete: if isSuperAdmin();
    }

    match /client_portal_accounts/{id} {
      allow get, list: if canRead();
      // حسابات البوابة: إنشاؤها وتعديلها لمدير المكتب وحده
      allow create, update: if member() && (
        isSuperAdmin() || (isOfficeOwner() && ownsIncoming())
      );
      allow delete: if canHardDelete();
    }

    match /client_messages/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /client_requests/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /template_folders/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    match /custom_templates/{id} {
      allow get, list: if canRead();
      allow create: if canCreate();
      allow update: if canUpdate();
      allow delete: if canDelete();
    }

    /* ────────────────────────── السجلات غير القابلة للتعديل ────────────────────────── */

    // سجل التدقيق لا يُعدَّل ولا يُحذف — وإلا فقد قيمته كدليل (الوثيقة §خامساً)
    match /auditLogs/{id} {
      allow get, list: if canRead();
      allow create: if member() && ownsIncoming();
      allow update, delete: if false;
    }

    // سجل الوصول للمستندات السرية — نفس المنطق
    match /documents_access_log/{id} {
      allow get, list: if canRead();
      allow create: if member() && ownsIncoming();
      allow update, delete: if false;
    }

    // المقترحات يراها مقدمها ومدير المنصة فقط. المستخدم ينشئ، والإدارة تراجع وترد.
    match /productSuggestions/{suggestionId} {
      function suggestionParticipant() {
        return member() && (isSuperAdmin() || resource.data.createdBy == request.auth.uid);
      }
      allow read: if suggestionParticipant();
      allow create: if member() && !isSuperAdmin()
        && request.resource.data.keys().hasOnly(['title', 'details', 'category', 'status', 'createdBy', 'requesterName', 'lawyerId', 'adminResponse', 'createdAt', 'updatedAt', 'respondedAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lawyerId == myTenant()
        && request.resource.data.requesterName is string && request.resource.data.requesterName.size() <= 200
        && request.resource.data.title is string && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 200
        && request.resource.data.details is string && request.resource.data.details.size() >= 10 && request.resource.data.details.size() <= 4000
        && request.resource.data.category in ['واجهة وتجربة المستخدم', 'إدارة القضايا والجلسات', 'الحسابات والتقارير', 'المستندات والعقود', 'الذكاء الاصطناعي', 'ميزة جديدة أخرى']
        && request.resource.data.status == 'RECEIVED'
        && request.resource.data.adminResponse == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.respondedAt == null;
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminResponse', 'updatedAt', 'respondedAt'])
        && request.resource.data.status in ['RECEIVED', 'UNDER_REVIEW', 'PLANNED', 'IMPLEMENTED', 'DECLINED']
        && request.resource.data.adminResponse is string && request.resource.data.adminResponse.size() <= 4000
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.adminResponse == '' && request.resource.data.respondedAt == null)
          || (request.resource.data.adminResponse.size() > 0 && request.resource.data.respondedAt == request.time));
      allow delete: if false;
    }

    // الدعم بين مقدم الطلب وإدارة المنصة فقط، وليس بقية أعضاء المكتب.
    match /supportTickets/{ticketId} {
      function attachment(a) {
        return a.keys().hasOnly(['name', 'path', 'size', 'type'])
          && a.name is string && a.name.size() > 0 && a.name.size() <= 200
          && a.path is string && a.path.matches('supportAttachments/' + ticketId + '/' + request.auth.uid + '/[^/]+')
          && a.size is int && a.size > 0 && a.size <= 5242880
          && a.type in ['image/png', 'image/jpeg', 'image/webp', 'application/pdf'];
      }
      function attachments(data) {
        let a = data.attachments;
        return a is list && a.size() <= 4
          && (a.size() < 1 || attachment(a[0])) && (a.size() < 2 || attachment(a[1]))
          && (a.size() < 3 || attachment(a[2])) && (a.size() < 4 || attachment(a[3]));
      }
      function participant() {
        return member() && (isSuperAdmin() || resource.data.createdBy == request.auth.uid);
      }
      function validStatus() {
        return request.resource.data.status in ['OPEN', 'IN_PROGRESS', 'WAITING', 'RESOLVED', 'CLOSED'];
      }
      function newReply() {
        let messageId = request.resource.data.lastMessageId;
        let path = /databases/$(database)/documents/supportTickets/$(ticketId)/messages/$(messageId);
        return messageId is string && messageId.size() > 0
          && messageId != resource.data.lastMessageId
          && !exists(path)
          && getAfter(path).data.senderId == request.auth.uid
          && getAfter(path).data.createdAt == request.time
          && request.resource.data.messageCount == resource.data.messageCount + 1
          && !(resource.data.status in ['CLOSED', 'RESOLVED'])
          && request.resource.data.status == (isSuperAdmin() ? 'WAITING' : 'OPEN')
          && request.resource.data.lastReplyBy == (isSuperAdmin() ? 'ADMIN' : 'USER');
      }
      allow read: if participant();
      allow create: if member() && !isSuperAdmin()
        && request.resource.data.keys().hasOnly(['subject', 'description', 'category', 'priority', 'status', 'createdBy', 'requesterName', 'lawyerId', 'createdAt', 'updatedAt', 'lastMessageId', 'lastReplyBy', 'messageCount', 'attachments'])
        && attachments(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.lawyerId == myTenant()
        && request.resource.data.requesterName is string
        && request.resource.data.requesterName.size() <= 200
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3 && request.resource.data.subject.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10 && request.resource.data.description.size() <= 3000
        && request.resource.data.category in ['مشكلة تقنية أو عطل في النظام', 'الحساب والصلاحيات', 'الاشتراكات والفواتير والمدفوعات', 'اقتراح وتطوير', 'استفسار عام أو مساعدة']
        && request.resource.data.priority in ['LOW', 'NORMAL', 'HIGH', 'URGENT']
        && request.resource.data.status == 'OPEN'
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.lastMessageId == '' && request.resource.data.lastReplyBy == ''
        && request.resource.data.messageCount == 1;
      allow update: if participant() && validStatus()
        && request.resource.data.updatedAt == request.time
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && (isSuperAdmin() || (resource.data.status in ['RESOLVED', 'CLOSED'] && request.resource.data.status == 'OPEN') || request.resource.data.status == 'CLOSED'))
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'lastMessageId', 'lastReplyBy', 'messageCount']) && newReply())
        );
      allow delete: if false;

      match /messages/{messageId} {
        function ticket() {
          return get(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
        }
        function ticketAfter() {
          return getAfter(/databases/$(database)/documents/supportTickets/$(ticketId)).data;
        }
        allow read: if member() && (isSuperAdmin() || ticket().createdBy == request.auth.uid);
        allow create: if member() && (isSuperAdmin() || ticket().createdBy == request.auth.uid)
          && !(ticket().status in ['CLOSED', 'RESOLVED'])
          && request.resource.data.keys().hasOnly(['body', 'senderId', 'senderName', 'isAdmin', 'createdAt', 'attachments'])
          && attachments(request.resource.data)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string && request.resource.data.senderName.size() <= 200
          && request.resource.data.isAdmin == isSuperAdmin()
          && request.resource.data.body is string && request.resource.data.body.size() <= 10000
          && (request.resource.data.body.size() > 0 || request.resource.data.attachments.size() > 0)
          && request.resource.data.createdAt == request.time
          && ticketAfter().lastMessageId == messageId && ticketAfter().updatedAt == request.time
          && ticketAfter().messageCount == ticket().messageCount + 1;
        allow update, delete: if false;
      }
    }

    /* ────────────────────────── الافتراضي: الرفض ────────────────────────── */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
