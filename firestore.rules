rules_version = '2';

/**
 * موازين انتقل بالكامل إلى MySQL (public/api) — التطبيق ما يقرأ ولا يكتب في Firestore أبداً.
 * النسخة الباقية هنا قديمة ومقفلة بالكامل: ما أحد يوصل لها من المتصفح.
 *
 * ⚠️ تُنشر هذه القواعد بعد نشر الموقع ونقل البيانات (database/migrate_users.php و migrate_store.php).
 * القواعد التفصيلية القديمة في تاريخ git لهذا الملف — ونفس الصلاحيات منقولة إلى
 * public/api/_lib/store.php و store_rules.php.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
