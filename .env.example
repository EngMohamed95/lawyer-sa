# Database Configuration
# Use your production MySQL URL or a local database URL.
DATABASE_URL="mysql://user:password@host:3306/database"

# Firebase Admin Configuration
# Paste the full service account JSON on one line for Vercel/production.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-project-id"}'

# AI Configuration
GEMINI_API_KEY="your_api_key_here"

# Server Configuration
PORT=3000
NODE_ENV=production

# Security
# مسار /create-admin معطّل افتراضياً. كان مفتوحاً للجميع وأتاح لأي زائر
# إنشاء حساب SUPER_ADMIN لنفسه. لا تفعّله في الإنتاج إطلاقاً.
# الطريقة الصحيحة لإنشاء مدير عام: node create_admin.mjs (يعمل بصلاحيات الخادم)
VITE_ENABLE_CREATE_ADMIN=false
