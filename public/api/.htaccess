# بدون RewriteEngine هنا عمداً: تفعيله في مجلد فرعي يلغي قواعد إعادة التوجيه في .htaccess
# الجذر على Apache (/api/v1/* و /api/ai/generate). الحماية بـ FilesMatch تكفي:
# ملفات المكتبة الداخلية (_lib) ما تُطلب من المتصفح — فقط index.php
<FilesMatch "\.php$">
  Require all denied
</FilesMatch>
<Files "index.php">
  Require all granted
</Files>
