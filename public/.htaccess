# ملفات الأسرار والسكربتات الداخلية — لا تُقدَّم للمتصفح أبداً (ai-proxy.php يقرأ ai-config.php من القرص، وtrial-cleanup.php يعمل من Cron)
<FilesMatch "^(ai-config\.php|mail-config\.php|db-config\.php|serviceAccountKey\.json|\.env|_common\.php|_firebase\.php|_mailer\.php|trial-cleanup\.php)$">
  Require all denied
</FilesMatch>

# بعض إعدادات PHP تُسقط ترويسة Authorization — نمرّرها صراحةً لـ ai-proxy.php
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^vendor(?:/|$) - [F,L]
  # ملفات المستخدمين: ما يتشغل فيها أي سكربت ولا صفحة (حتى لو انرفع ملف قديم قبل التحصين)
  RewriteRule ^(?:dist/)?uploads/.*\.(?:php\d?|phtml|phar|pht|phps|shtml|cgi|pl|py|html?|svg|xml|js)$ - [F,NC,L]
  # نسخة dist/ موجودة لتطبيق Node فقط — سكربتات PHP منها ما تُخدم (الـ API الحقيقي في الجذر).
  # بالرابط الكامل (REQUEST_URI) لأن dist/ فيها نسخة من هذا الملف ومساراتها نسبية لها
  RewriteCond %{REQUEST_URI} ^/dist/.*\.php [NC,OR]
  RewriteCond %{REQUEST_URI} ^/(?:dist/)?(?:private_files|api/_lib)(?:/|$) [NC]
  RewriteRule ^ - [F,L]
  # الاستضافة لا تشغّل Node — وسيط الذكاء الاصطناعي بـ PHP على نفس المسار
  RewriteRule ^api/ai/generate$ ai-proxy.php [L]
  # API قاعدة MySQL (public/api/index.php)
  RewriteRule ^api/v1/(.*)$ api/index.php?__route=$1 [QSA,L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>
